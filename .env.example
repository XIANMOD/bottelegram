# Required: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Google AI Studio API key
GEMINI_API_KEY=

# Required: fal.ai API key
FAL_KEY=

# Optional: models can be changed later after testing
GEMINI_MODEL=gemini-2.5-flash
FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/ovi/image-to-video
FAL_TEXT_TO_VIDEO_MODEL=fal-ai/ovi

# Optional: Railway will provide PORT automatically
PORT=3000
