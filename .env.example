# Required: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Groq API key from Groq Console
GROQ_API_KEY=

# Required: fal.ai API key
FAL_KEY=

# Optional: leave GROQ_MODEL empty to use the built-in default (qwen/qwen3.8-27b).
# Only set it if the model supports image input: https://console.groq.com/docs/vision
GROQ_MODEL=
FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/ovi/image-to-video
FAL_TEXT_TO_VIDEO_MODEL=fal-ai/ovi

# Optional: Railway will provide PORT automatically
PORT=3000
